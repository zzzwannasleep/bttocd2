# 复制为 .env 后按需修改（docker compose 会自动读取）

# ===== Web UI 登录 =====
WEB_USERNAME=admin
# 留空则首次启动自动生成随机密码并写入日志 + /data/web_password.txt
WEB_PASSWORD=
# 会话签名密钥，留空自动生成并持久化到 /data/secret.key
# SECRET_KEY=

# ===== CloudDrive2 =====
# 容器访问宿主机上的 CD2 用 host.docker.internal；CD2 在别的机器则填其地址
CD2_URL=http://host.docker.internal:19798
CD2_USERNAME=你的CD2账号
CD2_PASSWORD=你的CD2密码
# 离线下载默认落地的 CD2 路径（订阅里可单独覆盖），例如 /115网盘/离线下载
DEFAULT_TARGET_FOLDER=/

# ===== 风控 / 反 Cloudflare =====
HOST_MIN_INTERVAL=30
FETCH_JITTER_SECONDS=20
DEFAULT_INTERVAL_MINUTES=30
MAX_ITEMS_PER_RUN=20
# 硬 Cloudflare 盾（Turnstile/Managed Challenge）时启用 FlareSolverr：
# FLARESOLVERR_URL=http://flaresolverr:8191
# 抓取走代理（科学上网 / 换 IP 降低封禁概率）：
# CRAWL_PROXY=http://127.0.0.1:7890
# 自定义 UA 池（逗号分隔），留空用内置池：
# USER_AGENTS=
